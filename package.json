{
  "name": "flowboard",
  "version": "1.0.0",
  "private": true,
  "description": "BPMN editor with saved projects, version history, live collaboration and an AI assistant",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node apps/standalone/src/main.ts",
    "test": "vitest run && node --test test/*.test.mjs",
    "test:unit": "vitest run",
    "test:api": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
