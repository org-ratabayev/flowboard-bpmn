# Copy to .env for machine-specific settings (.env is git-ignored).

# Data folder: holds the SQLite database (flowboard.sqlite); project folders found here are
# imported on first start
BPMN_DIR=~/workspace/bpmn-diagrams

# Storage: SQLite by default; set DATABASE_URL to use Postgres instead
# SQLITE_PATH=~/workspace/bpmn-diagrams/flowboard.sqlite
# DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard
# PG_POOL_SIZE=10
# IMPORT_ON_FIRST_START=off

PORT=3000
# HOST=0.0.0.0

# Claude chat: set CHAT=off to disable it
CHAT=on
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet
# CHAT_TIMEOUT_MS=300000

# Optional JavaScript module whose default export is a configuration object
# (environment variables still take priority over it)
# APP_CONFIG=./app.config.mjs
