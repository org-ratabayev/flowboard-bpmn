# Copy to .env for machine-specific settings (.env is git-ignored).

# Data folder: holds the SQLite database (flowboard.sqlite); project folders found here are
# imported on first start
BPMN_DIR=~/workspace/bpmn-diagrams

# Storage: SQLite by default; set DATABASE_URL to use Postgres instead
# SQLITE_PATH=~/workspace/bpmn-diagrams/flowboard.sqlite
# DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard
# PG_POOL_SIZE=10
# IMPORT_ON_FIRST_START=off

PORT=3000
# HOST=0.0.0.0

# Sign-in: dev (a name, no password; trusted networks only), oidc (an OpenID Connect provider)
# or trusted-headers (behind an authenticating reverse proxy), see README "Sign-in"
# AUTH=dev
# SESSION_DAYS=30
# PUBLIC_ORIGIN=https://bpmn.example.com
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_DOMAINS=example.com
# AUTH_SUBJECT_HEADER=x-forwarded-user
# AUTH_NAME_HEADER=x-forwarded-name
# AUTH_EMAIL_HEADER=x-forwarded-email
# AUTH_PROXY_SECRET_HEADER=x-proxy-secret
# AUTH_PROXY_SECRET=
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# AUTH_TOKEN_HEADER=x-forwarded-access-token

# AI providers, see README "AI providers": personal (each user's own key) or managed
# LLM_MODE=personal
# LLM_PROVIDERS=[{"id":"gateway","label":"Gateway models","type":"openai-compatible","baseUrl":"https://llm.example.com/v1","credentials":{"from":"identity"}}]
# Protects users' own AI keys; required with Postgres (openssl rand -base64 48)
# APP_SECRET=

# AI assistant (chat) on the AI providers above, see README "AI assistant" and "Chat API";
# set CHAT=off to disable it
CHAT=on
# CHAT_TOOL_TIMEOUT_MS=30000
# CHAT_IDLE_DAYS=30
# CHAT_TURNS_PER_MINUTE=10
# CHAT_SYSTEM_PROMPT_APPEND=Name tasks in English.
# Development only (needs AUTH=dev): offer the local Claude Code CLI as a provider; it bills the
# Claude account signed in on this machine for every user
# CHAT_CLAUDE_CODE=on
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet
# CHAT_TIMEOUT_MS=300000

# Optional JavaScript module whose default export is a configuration object
# (environment variables still take priority over it)
# APP_CONFIG=./app.config.mjs
